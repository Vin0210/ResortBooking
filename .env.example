# Supabase configuration
# Copy this file to .env and fill in your project values.
# Get these from: Supabase Dashboard -> Project Settings -> API

# These values are safe to expose to the frontend (protected by RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service_role key in this file or any frontend code.
